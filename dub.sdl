name "dubx"
description "Thin meta-CLI: redub for builds, dub-publish for registry owner ops"
authors "amdphreak"
copyright "Copyright © 2026, amdphreak"
license "BSL-1.0"
# Version comes from git tags (vX.Y.Z) / VERSION file for --version.

targetType "executable"
targetName "dubx"

versions "DubxCli"

# CI checkouts openshellorg/prohelp@v0.2.3 into deps/prohelp (see workflows).
# Local: junction or clone — e.g. mklink /J deps\prohelp C:\code\github.com\dev-centr\prohelp
dependency "prohelp" path="deps/prohelp"
dependency "sdlang-d" version="~>0.10.6"

importPaths "source"
sourcePaths "source"
stringImportPaths "embed"
stringImportPaths "strimport"

libs "user32" platform="windows"
