command "dubx" {
    summary "Thin meta-CLI for D package workflows"
    description "Routes verbs to the right backend without reimplementing them: redub (or dub) for builds, dub-publish for registry owner ops."

    section "usage" {
        summary "How to invoke"
        content "dubx <verb> [args...]"

        example "Show this help" "dubx"
        example "Progressive help / TUI" "dubx ?"
        example "Build with redub/dub" "dubx build"
        example "Register via dub-publish" "dubx publish --ignore-fork"
        example "See which backends are on PATH" "dubx which"
    }

    section "install" {
        summary "Installers (win / mac / linux)"
        content "Release archives ship install.ps1 (Windows), install.sh (macOS/Linux), and install.nu (nushell wrapper). Targets: windows-x64, linux-x64, macos-x64, macos-arm64."

        example "Windows PowerShell" "powershell -ExecutionPolicy Bypass -File .\\install.ps1"
        example "nushell" "nu install.nu"
        example "macOS / Linux bash" "bash ./install.sh"
        example "Refresh PATH in nushell" "$env.PATH = ($env.PATH | prepend $installDir)"
    }

    section "build" {
        summary "Build verbs -> redub (fallback dub)"
        inline true
        content "build run test describe lint clean fetch upgrade add convert search list ..."

        example "Force dub" "dubx dub build"
        example "Force redub" "dubx redub build"
    }

    section "registry" {
        summary "Registry verbs -> dub-publish"
        inline true
        content "publish register login logout update status hooks logo docs-url categories ..."

        example "Passthrough" "dubx dub-publish status -n mypkg"
    }

    section "discovery" {
        summary "Backend discovery"
        content "dubx which [redub|dub|dub-publish]"
    }

    section "backends" {
        summary "Install separately on PATH"
        content "redub: code.dlang.org/packages/redub — dub-publish: github.com/dlang-supplemental/dub-publish/releases"
    }
}
