command "dubx" {
    summary "Thin meta-CLI for D package workflows"
    description "Routes verbs to the right backend without reimplementing them: redub (or dub) for builds, dub-publish for registry owner ops, dubproxy for local/private package mirrors."

    section "usage" {
        summary "How to invoke"
        content "dubx <verb> [args...]"

        example "Show this help" "dubx"
        example "Progressive help / TUI" "dubx ?"
        example "Build with redub/dub" "dubx build"
        example "Register via dub-publish" "dubx publish register --ignore-fork"
        example "Login via publish namespace" "dubx publish login --user NAME --save-credentials"
        example "Local/private mirror via dubproxy" "dubx local -h"
        example "See which backends are on PATH" "dubx which"
    }

    section "install" {
        summary "Installers (win / mac / linux)"
        content "Release archives ship install.ps1 (Windows), install.sh (macOS/Linux), and install.nu (nushell wrapper). Targets: windows-x64, linux-x64, macos-x64, macos-arm64."

        example "Windows PowerShell" "powershell -ExecutionPolicy Bypass -File .\\install.ps1"
        example "nushell" "nu install.nu"
        example "macOS / Linux bash" "bash ./install.sh"
        example "Refresh PATH in nushell" "$env.PATH = ($env.PATH | prepend $installDir)"
    }

    section "build" {
        summary "Build verbs -> redub (fallback dub)"
        inline true
        content "build run test describe lint clean fetch upgrade add convert search list ..."

        example "Force dub" "dubx dub build"
        example "Force redub" "dubx redub build"
    }

    section "registry" {
        summary "Registry verbs -> dub-publish"
        content "Namespace: dubx publish <dub-publish args…> passes through unchanged (except any verb dubx explicitly remaps). Short aliases (login, register, status, …) still work at the top level. Escape hatch: dubx dub-publish …"

        example "Passthrough namespace" "dubx publish login --user NAME --save-credentials"
        example "Register" "dubx publish register --ignore-fork"
        example "Short alias" "dubx status -n mypkg"
        example "Escape hatch" "dubx dub-publish status -n mypkg"
    }

    section "local" {
        summary "Local/private packages -> dubproxy"
        content "dubx local <dubproxy args…> proxies dubproxy when installed. Injects git/private packages into ~/.dub/packages so dub/redub resolve them like registry packages. Prefer path deps, git+repository deps, or dub add-local when those suffice — global cache injection is a blunt tool."

        example "Help" "dubx local -h"
        example "Mirror package list" "dubx local -m -n codedlangorg.json"
    }

    section "discovery" {
        summary "Backend discovery"
        content "dubx which [redub|dub|dub-publish|dubproxy]"
    }

    section "backends" {
        summary "Install separately on PATH"
        content "redub: github.com/MrcSnm/redub/releases — dub-publish: github.com/dlang-supplemental/dub-publish/releases — dubproxy (optional): github.com/symmetryinvestments/dubproxy"
    }
}
